<Project>
  <PropertyGroup>
    <FixtureRuntimeVersions>1.2.3;3.4.5;1.2.3</FixtureRuntimeVersions>
    <FixtureRuntimeVersions Condition="'$(FixtureMode)' == 'NoRuntimes'"></FixtureRuntimeVersions>
  </PropertyGroup>

  <Target Name="Build">
    <Error Text="Helix payload creation must never build a test project." />
  </Target>

  <Target Name="Restore">
    <WriteLinesToFile File="$(SubmissionTestRoot)restored.txt" Lines="restored package inputs" Overwrite="true" />
  </Target>

  <Target Name="CreateHelixPayload" Returns="@(HelixWorkItem)">
    <PropertyGroup>
      <_Input>$(SubmissionTestRoot)fixture.txt</_Input>
      <_Input Condition="'$(FixtureMode)' == 'Missing'">$(SubmissionTestRoot)missing.txt</_Input>
      <_Payload>$(SubmissionTestRoot)payloads/$(HelixTargetQueue)</_Payload>
    </PropertyGroup>
    <Error Condition="!Exists('$(_Input)')" Text="The prebuilt fixture '$(_Input)' was not found." />
    <MakeDir Directories="$(_Payload)" />
    <Copy SourceFiles="$(_Input)" DestinationFiles="$(_Payload)/fixture.txt" />
    <ZipDirectory SourceDirectory="$(_Payload)" DestinationFile="$(_Payload).zip" Overwrite="true" />
    <ItemGroup>
      <HelixWorkItem Include="Archive shard">
        <Command>echo &quot;a;b &amp; c&quot;</Command>
        <PayloadArchive>$(_Payload).zip</PayloadArchive>
        <Timeout>00:42:00</Timeout>
        <PreCommands>echo before;echo again</PreCommands>
        <PostCommands>echo after</PostCommands>
        <RequiredRuntimeVersions>$(FixtureRuntimeVersions)</RequiredRuntimeVersions>
      </HelixWorkItem>
      <HelixWorkItem Include="Directory shard">
        <Command>echo directory</Command>
        <PayloadDirectory>$(_Payload)</PayloadDirectory>
        <Timeout>00:30:00</Timeout>
        <RequiredRuntimeVersions>$(FixtureRuntimeVersions)</RequiredRuntimeVersions>
      </HelixWorkItem>
      <HelixWorkItem Include="Archive shard" Condition="'$(FixtureMode)' == 'Duplicate'"
                     Command="echo duplicate" PayloadDirectory="$(_Payload)" RequiredRuntimeVersions="$(FixtureRuntimeVersions)" />
    </ItemGroup>
  </Target>
</Project>
