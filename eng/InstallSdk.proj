<Project DefaultTargets="InstallSdk">
  <Choose>
    <When Condition="$([MSBuild]::IsOsPlatform(Windows))">
      <PropertyGroup>
        <PowershellWrapper>powershell -NonInteractive -ExecutionPolicy ByPass -NoProfile -command</PowershellWrapper>
        <DotnetInstallScriptCmd>'$(MSBuildThisFileDirectory)dotnet-install.ps1'</DotnetInstallScriptCmd>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <DotnetInstallScriptCmd>&quot;$(MSBuildThisFileDirectory)dotnet-install.sh&quot;</DotnetInstallScriptCmd>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <Target Name="InstallSdk" DependsOnTargets="CheckSdkInstallation;InstallSdkCore" />

  <Target Name="CheckSdkInstallation">

    <Error Condition="'$(InstallRoot)' == '' or '$(SdkBuildIdentifier)' == '' or '$(SdkArchitecture)' == ''"
           Text="InstallRoot, SdkBuildIdentifier, and SdkArchitecture are required." />

    <PropertyGroup>
      <_SdkInstallRoot>$([MSBuild]::NormalizeDirectory('$(InstallRoot)'))</_SdkInstallRoot>
      <_SdkStamp>$(_SdkInstallRoot)sdk-install.txt</_SdkStamp>
      <_DotNetPath>$(_SdkInstallRoot)dotnet</_DotNetPath>
      <_DotNetPath Condition="$([MSBuild]::IsOsPlatform(Windows))">$(_SdkInstallRoot)dotnet.exe</_DotNetPath>
      <SdkInstallArgs>-NoPath -SkipNonVersionedFiles -Architecture $(SdkArchitecture) -InstallDir '$(_SdkInstallRoot.TrimEnd('\/'))' -Version $(SdkBuildIdentifier)</SdkInstallArgs>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(_SdkInstallRoot)sdk')">
      <_InstalledSdkDirectories Include="$([System.IO.Directory]::GetDirectories('$(_SdkInstallRoot)sdk'))" />
    </ItemGroup>

    <PropertyGroup Condition="'@(_InstalledSdkDirectories->Count())' == '1'">
      <_InstalledSdkDirectory>@(_InstalledSdkDirectories)</_InstalledSdkDirectory>
      <_InstalledSdkVersion>$([System.IO.Path]::GetFileName('$(_InstalledSdkDirectory)'))</_InstalledSdkVersion>
    </PropertyGroup>

    <ReadLinesFromFile File="$(_SdkStamp)" Condition="Exists('$(_SdkStamp)')">
      <Output TaskParameter="Lines" PropertyName="_InstalledSdkIdentity" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_ExpectedSdkIdentity>$(SdkBuildIdentifier)|$(SdkArchitecture)|$(_InstalledSdkVersion)</_ExpectedSdkIdentity>
      <_InstallSdk Condition="'$(_InstalledSdkIdentity)' != '$(_ExpectedSdkIdentity)' or '$(_InstalledSdkVersion)' == '' or !Exists('$(_DotNetPath)') or !Exists('$(_SdkInstallRoot)sdk/$(_InstalledSdkVersion)/dotnet.dll') or !Exists('$(_SdkInstallRoot)sdk/$(_InstalledSdkVersion)/Sdks/Microsoft.NET.Sdk/Sdk/Sdk.props')">true</_InstallSdk>
    </PropertyGroup>
  </Target>

  <Target Name="InstallSdkCore" Condition="'$(_InstallSdk)' == 'true'">
    <!-- Different builds can install the same product version. Remove SDKs before
         installation so dotnet-install cannot mistake the old build for this one. -->
    <Delete Files="$(_SdkStamp)" />
    <RemoveDir Directories="@(_InstalledSdkDirectories)" />

    <Exec Command="$(PowershellWrapper) &quot;&amp; { &amp;$(DotnetInstallScriptCmd) $(SdkInstallArgs) }&quot;"
          Condition="$([MSBuild]::IsOsPlatform(Windows))"
          IgnoreStandardErrorWarningFormat="true" />
    <Exec Command="bash $(DotnetInstallScriptCmd) $(SdkInstallArgs)"
          Condition="!$([MSBuild]::IsOsPlatform(Windows))"
          IgnoreStandardErrorWarningFormat="true" />

    <ItemGroup>
      <_InstalledSdkDirectories Remove="@(_InstalledSdkDirectories)" />
      <_InstalledSdkDirectories Include="$([System.IO.Directory]::GetDirectories('$(_SdkInstallRoot)sdk'))" Condition="Exists('$(_SdkInstallRoot)sdk')" />
    </ItemGroup>
    <Error Condition="'@(_InstalledSdkDirectories->Count())' != '1'"
           Text="Expected exactly one SDK in $(_SdkInstallRoot)sdk after installing $(SdkBuildIdentifier)." />

    <PropertyGroup>
      <_InstalledSdkDirectory>@(_InstalledSdkDirectories)</_InstalledSdkDirectory>
      <_InstalledSdkVersion>$([System.IO.Path]::GetFileName('$(_InstalledSdkDirectory)'))</_InstalledSdkVersion>
    </PropertyGroup>
    <Error Condition="!Exists('$(_DotNetPath)') or !Exists('$(_SdkInstallRoot)sdk/$(_InstalledSdkVersion)/dotnet.dll') or !Exists('$(_SdkInstallRoot)sdk/$(_InstalledSdkVersion)/Sdks/Microsoft.NET.Sdk/Sdk/Sdk.props')"
           Text="SDK $(SdkBuildIdentifier) is incomplete in $(_SdkInstallRoot)." />
    <WriteLinesToFile File="$(_SdkStamp)"
                      Lines="$(SdkBuildIdentifier)|$(SdkArchitecture)|$(_InstalledSdkVersion)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
