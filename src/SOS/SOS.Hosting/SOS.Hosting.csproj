<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(NetCoreAppMinTargetFramework)</TargetFramework>
    <AssemblyName>SOS.Hosting</AssemblyName>
    <NoWarn>$(NoWarn);1591;1701;IDE0060</NoWarn>
    <IsPackable>true</IsPackable>
    <Description>Diagnostic SOS hosting support</Description>
    <PackageReleaseNotes>$(Description)</PackageReleaseNotes>
    <PackageTags>SOS</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsShipping>true</IsShipping>
    <IsShippingPackage>false</IsShippingPackage>
    <CDacSourceRoot>$(MSBuildThisFileDirectory)..\..\cdac\runtime\src\native\managed\cdac</CDacSourceRoot>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Match cDAC's COM pointer warning policy for the linked declarations. -->
    <NoWarn>$(NoWarn);SYSLIB1054;CA1416;CA2249;CS8500;CS8969</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="$(MicrosoftDiagnosticsRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbgShim.UnitTests" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Microsoft.Diagnostics.DebugServices\Microsoft.Diagnostics.DebugServices.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Microsoft.SymbolStore\Microsoft.SymbolStore.csproj" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Microsoft.Diagnostics.DebugServices.Implementation\PathUtilities.cs" Link="Shared\PathUtilities.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(CDacSourceRoot)\Microsoft.Diagnostics.DataContractReader.Legacy\ISOSDacInterface.cs;
                      $(CDacSourceRoot)\Microsoft.Diagnostics.DataContractReader.Legacy\IXCLRData.cs;
                      $(CDacSourceRoot)\Microsoft.Diagnostics.DataContractReader.Legacy\ICLRData.cs;
                      $(CDacSourceRoot)\Microsoft.Diagnostics.DataContractReader.Legacy\IMetaDataImport.cs;
                      $(CDacSourceRoot)\Microsoft.Diagnostics.DataContractReader.Legacy\Interop.BOOL.cs;
                      $(CDacSourceRoot)\Microsoft.Diagnostics.DataContractReader.Legacy\Marshalling\ClrDataAddress.cs;
                      $(CDacSourceRoot)\Microsoft.Diagnostics.DataContractReader.Legacy\Marshalling\DacComNullableByRef.cs;
                      $(CDacSourceRoot)\..\..\..\libraries\Common\src\System\HResults.cs"
             Link="Interop\CDac\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
