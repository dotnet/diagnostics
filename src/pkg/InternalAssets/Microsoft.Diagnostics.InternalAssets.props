<Project Sdk="Microsoft.Build.NoTargets">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>runtime.$(PackageRID).Microsoft.Diagnostics.InternalAssets</PackageId>
    <IsPackable>true</IsPackable>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <IncludeSymbols>true</IncludeSymbols>
    <AllowedOutputExtensionsInSymbolsPackageBuildOutputFolder>$(SymbolsSuffix)</AllowedOutputExtensionsInSymbolsPackageBuildOutputFolder>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);AddInternalAssetsSymbolsToPackage</TargetsForTfmSpecificDebugSymbolsInPackage>
    <UseRuntimePackageDisclaimer>true</UseRuntimePackageDisclaimer>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <NativeBinary Include="$(NativeBinDir)$(LibPrefix)mscordaccore_universal$(LibSuffix)" />
    <NativeBinary Include="$(NativeBinDir)$(LibPrefix)mscordbi_universal$(LibSuffix)" />
    <None Include="@(NativeBinary)" Pack="true" PackagePath="runtimes/$(PackageRID)/native" />
    <None Include="$(RepoRoot)THIRD-PARTY-NOTICES.TXT" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="ValidateInternalAssets" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('%(NativeBinary.Identity)')"
           Text="Native transport binary not found: %(NativeBinary.Identity). Build the cDAC reader and install the universal DBI before packing." />
  </Target>

  <Target Name="AddInternalAssetsSymbolsToPackage">
    <ItemGroup>
      <_InternalAssetsSymbol Include="@(NativeBinary)"
                             Condition="$(PackageRID.StartsWith('win')) or '$(KeepNativeSymbols)' != 'true'">
        <SymbolPath>%(Identity)$(SymbolsSuffix)</SymbolPath>
        <SymbolPath Condition="$(PackageRID.StartsWith('win'))">%(RootDir)%(Directory)%(Filename).pdb</SymbolPath>
      </_InternalAssetsSymbol>
    </ItemGroup>
    <ItemGroup Condition="$(PackageRID.StartsWith('win'))">
      <_InternalAssetsSymbol Condition="!Exists('%(_InternalAssetsSymbol.SymbolPath)')">
        <SymbolPath>%(_InternalAssetsSymbol.RootDir)%(_InternalAssetsSymbol.Directory)PDB\%(_InternalAssetsSymbol.Filename).pdb</SymbolPath>
      </_InternalAssetsSymbol>
    </ItemGroup>
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="@(_InternalAssetsSymbol->'%(SymbolPath)')"
                                  Condition="Exists('%(_InternalAssetsSymbol.SymbolPath)')"
                                  TargetPath="/runtimes/$(PackageRID)/native/$([System.IO.Path]::GetFileName('%(_InternalAssetsSymbol.SymbolPath)'))"
                                  TargetFramework="$(TargetFramework)" />
    </ItemGroup>
  </Target>
</Project>
