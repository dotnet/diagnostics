<Project Sdk="Microsoft.Build.Traversal">
  <ItemGroup>
    <!-- Temporarily exclude linux-arm from release packaging: https://github.com/dotnet/diagnostics/issues/6174 -->
    <ProjectReference Include="Microsoft.Diagnostics.InternalAssets.*.proj"
                      Exclude="Microsoft.Diagnostics.InternalAssets.linux-arm.proj"
                      Condition="'$(SingleTargetRidPackage)' != 'true'" />
    <ProjectReference Include="Microsoft.Diagnostics.InternalAssets.$(TargetRid).proj" Condition="'$(SingleTargetRidPackage)' == 'true'" />
  </ItemGroup>
</Project>
