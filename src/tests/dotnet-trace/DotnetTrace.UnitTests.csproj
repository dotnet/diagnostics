  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Common\MockConsole.cs" Link="MockConsole.cs" />
  </ItemGroup>

  <Import Project="..\CommonTestRunner\HelixPayload.targets" />

</Project>
