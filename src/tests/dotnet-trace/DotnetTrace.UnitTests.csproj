<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsHelixTestProject>true</IsHelixTestProject>
    <HelixIncludeDotNetTrace>true</HelixIncludeDotNetTrace>
    <TargetFramework>$(NetCoreAppTestTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SrcDir)Tools/dotnet-trace/dotnet-trace.csproj" />
