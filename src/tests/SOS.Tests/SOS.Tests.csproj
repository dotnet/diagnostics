<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: the harness depends on Microsoft.Diagnostics.Runtime.Utilities, which ships
         net10.0-only, so the test project must target net10.0 (overriding the repo's net8.0 default). -->
    <TargetFrameworks>$(NetCoreAppTestTargetFramework)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Modern SOS test home: xunit v3 (Microsoft.Testing.Platform). Arcade's XUnitV3 target
         implicitly references xunit.v3 and the test runner; no explicit PackageReference needed.
         xunit v3 runs as an MTP executable, so OutputType must be Exe. -->
    <TestRunnerName>XUnitV3</TestRunnerName>
    <SkipTests Condition="'$(SOSHARNESS_SKIP_LOCAL_TESTS)' == 'true'">true</SkipTests>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SOS.TestHarness\SOS.TestHarness.csproj" />
    <ProjectReference Include="..\SOS.TestHarness.SourceGen\SOS.TestHarness.SourceGen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Debuggee sources whose public const / static-readonly fields are mirrored into the test project
         (TestTargets.<Type>.<Field>) by the source generator, for value-oracle assertions. -->
    <AdditionalFiles Include="..\SOS.UnitTests\Debuggees\SosHarnessScenarios\SosHarnessScenarios.cs" />
  </ItemGroup>

  <Target Name="EnsureUnixTestAppHostExecutable"
          BeforeTargets="RunTests"
          Condition="'$(OS)' != 'Windows_NT' and '$(SkipTests)' != 'true'">
    <!-- Pipeline artifact transfer does not preserve Unix executable permissions. -->
    <Exec Command="chmod +x &quot;%(TestToRun.RunCommand)&quot;" />
  </Target>

</Project>
