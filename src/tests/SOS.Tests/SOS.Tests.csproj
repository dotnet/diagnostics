<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsHelixTestProject>true</IsHelixTestProject>
    <!-- net10.0 only: the harness depends on Microsoft.Diagnostics.Runtime.Utilities, which ships
         net10.0-only, so the test project must target net10.0 (overriding the repo's net8.0 default). -->
    <TargetFrameworks>$(NetCoreAppTestTargetFramework)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Microsoft.FileFormats\Microsoft.FileFormats.csproj" />
    <ProjectReference Include="..\SOS.TestHarness\SOS.TestHarness.csproj" />
    <ProjectReference Include="..\TestExtension\TestExtension.csproj" />
    <ProjectReference Include="..\SOS.Cohost\SOS.Cohost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SOS.TestHarness.SourceGen\SOS.TestHarness.SourceGen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="IncludeCohost" BeforeTargets="GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems">
    <ItemGroup>
      <CohostFiles Include="$(ArtifactsBinDir)SOS.Cohost/$(Configuration)/$(NetCoreAppMinTargetFramework)/*.dll;
                            $(ArtifactsBinDir)SOS.Cohost/$(Configuration)/$(NetCoreAppMinTargetFramework)/*.json" />
      <ContentWithTargetPath Include="@(CohostFiles)">
        <TargetPath>Hosting/%(CohostFiles.Filename)%(CohostFiles.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Debuggee sources whose public const / static-readonly fields are mirrored into the test project
         (TestTargets.<Type>.<Field>) by the source generator, for value-oracle assertions. -->
    <AdditionalFiles Include="..\SOS.UnitTests\Debuggees\SosHarnessScenarios\SosHarnessScenarios.cs" />
  </ItemGroup>

  <Import Project="HelixPayload.targets" />

</Project>
