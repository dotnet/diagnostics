<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\SOSHarnessDebuggees.props" />

  <PropertyGroup>
    <SOSHelixPayloadDir Condition="'$(SOSHelixPayloadDir)' == ''">$(ArtifactsDir)helix/SOS.Tests/$(TargetRid)/$(Configuration)/payload</SOSHelixPayloadDir>
    <SOSHelixWorkItemName Condition="'$(SOSHelixWorkItemName)' == ''">SOS_$(TargetRid)_$(Configuration)</SOSHelixWorkItemName>
    <WorkItemTimeout Condition="'$(WorkItemTimeout)' == ''">02:00:00</WorkItemTimeout>
    <_SOSHelixWorkItemCommand Condition="'$(TargetOS)' == 'Windows_NT'">call .\runtests.cmd</_SOSHelixWorkItemCommand>
    <_SOSHelixWorkItemCommand Condition="'$(TargetOS)' != 'Windows_NT'">bash ./runtests.sh</_SOSHelixWorkItemCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="cdb-sos"
                     Version="[$(cdbsosversion)]"
                     Condition="'$(TargetOS)' == 'Windows_NT'" />
  </ItemGroup>

  <Target Name="StageSOSHelixPayload">
    <ItemGroup>
      <_SOSPayloadEngineeringFile Include="$(RepoRoot)eng/DisableSignatureCheck.ps1"
                                  Condition="'$(TargetOS)' == 'Windows_NT'" />
      <_SOSPayloadLauncherFile Include="$(MSBuildThisFileDirectory)Helix/run-sos-tests.cmd"
                               Condition="'$(TargetOS)' == 'Windows_NT'" />
      <_SOSPayloadLauncherFile Include="$(MSBuildThisFileDirectory)Helix/run-sos-tests.sh"
                               Condition="'$(TargetOS)' != 'Windows_NT'" />
      <_SOSPayloadEntitlementsFile Include="$(MSBuildThisFileDirectory)Helix/debuggee-entitlements.plist"
                                   Condition="'$(TargetOS)' == 'osx'" />

      <_SOSPayloadBinFile Include="$(ArtifactsBinDir)SOS.Tests/$(Configuration)/**/*;
                                  $(ArtifactsBinDir)SOS.TestHarness.EngineHost/$(Configuration)/**/*;
                                  $(ArtifactsBinDir)SOS.TestHarness.Capturer/$(Configuration)/**/*;
                                  $(ArtifactsBinDir)dotnet-dump/$(Configuration)/**/*" />
      <_SOSPayloadNativeFile Include="$(ArtifactsBinNativeDir)**/*" />
      <_SOSPayloadCDacFile Include="$(ArtifactsDir)cdac-override/$(Configuration)/**/*"
                           Condition="Exists('$(ArtifactsDir)cdac-override/$(Configuration)')" />
      <_SOSPayloadCdbFile Include="$(NuGetPackageRoot)cdb-sos/$(cdbsosversion)/runtimes/$(TargetRid)/native/*"
                          Condition="'$(TargetOS)' == 'Windows_NT'" />
      <_SOSPayloadDebuggerFile Include="@(_SOSPayloadCdbFile)"
                               Condition="'$(TargetOS)' == 'Windows_NT'" />
      <_SOSPayloadDebuggerFile Include="$(ArtifactsBinNativeDir)sos-lldb"
                               Condition="'$(TargetOS)' == 'osx'" />
    </ItemGroup>

    <!-- The RID directory beside publish is the loose self-contained publish intermediate and duplicates
         the runtime already embedded in the final single-file bundle. -->
    <CreateItem Include="@(SOSHarnessDebuggee->'$(ArtifactsBinDir)%(Filename)/$(Configuration)/net*/*');
                         @(SOSHarnessDebuggee->'$(ArtifactsBinDir)%(Filename)/$(Configuration)/net*/$(TargetRid)/publish/**/*')">
      <Output TaskParameter="Include" ItemName="_SOSPayloadBinFile" />
    </CreateItem>

    <ItemGroup>
      <_SOSPayloadFile Include="@(_SOSPayloadEngineeringFile)">
        <DestinationRelative>eng/%(_SOSPayloadEngineeringFile.Filename)%(_SOSPayloadEngineeringFile.Extension)</DestinationRelative>
      </_SOSPayloadFile>
      <_SOSPayloadFile Include="@(_SOSPayloadLauncherFile)">
        <DestinationRelative>runtests%(_SOSPayloadLauncherFile.Extension)</DestinationRelative>
      </_SOSPayloadFile>
      <_SOSPayloadFile Include="@(_SOSPayloadEntitlementsFile)">
        <DestinationRelative>eng/helix/sos/%(_SOSPayloadEntitlementsFile.Filename)%(_SOSPayloadEntitlementsFile.Extension)</DestinationRelative>
      </_SOSPayloadFile>
      <_SOSPayloadFile Include="@(_SOSPayloadBinFile)">
        <DestinationRelative>artifacts/bin/$([MSBuild]::MakeRelative('$(ArtifactsBinDir)', '%(_SOSPayloadBinFile.Identity)'))</DestinationRelative>
      </_SOSPayloadFile>
      <_SOSPayloadFile Include="@(_SOSPayloadNativeFile)">
        <DestinationRelative>artifacts/bin/$(TargetOS).$(TargetArch).$(Configuration)/%(_SOSPayloadNativeFile.RecursiveDir)%(_SOSPayloadNativeFile.Filename)%(_SOSPayloadNativeFile.Extension)</DestinationRelative>
      </_SOSPayloadFile>
      <_SOSPayloadFile Include="@(_SOSPayloadCDacFile)">
        <DestinationRelative>artifacts/cdac-override/$(Configuration)/%(_SOSPayloadCDacFile.RecursiveDir)%(_SOSPayloadCDacFile.Filename)%(_SOSPayloadCDacFile.Extension)</DestinationRelative>
      </_SOSPayloadFile>
      <_SOSPayloadFile Include="@(_SOSPayloadDebuggerFile)">
        <DestinationRelative>debugger/%(_SOSPayloadDebuggerFile.Filename)%(_SOSPayloadDebuggerFile.Extension)</DestinationRelative>
      </_SOSPayloadFile>
    </ItemGroup>

    <Error Condition="'@(_SOSPayloadFile)' == ''" Text="The SOS Helix payload is empty." />
    <Error Condition="!Exists('$(ArtifactsBinDir)SOS.Tests/$(Configuration)/$(NetCoreAppTestTargetFramework)/SOS.Tests.dll')"
           Text="SOS.Tests was not found under '$(ArtifactsBinDir)SOS.Tests/$(Configuration)'." />
    <Error Condition="!Exists('$(ArtifactsBinDir)dotnet-dump/$(Configuration)/net8.0/dotnet-dump.dll') and !Exists('$(ArtifactsBinDir)dotnet-dump/$(Configuration)/net8.0/publish/dotnet-dump.dll')"
           Text="dotnet-dump was not found under '$(ArtifactsBinDir)dotnet-dump/$(Configuration)'." />
    <Error Condition="'$(TargetOS)' == 'Windows_NT' and !Exists('$(ArtifactsBinNativeDir)sos.dll')"
           Text="Native SOS was not found at '$(ArtifactsBinNativeDir)sos.dll'." />
    <Error Condition="'$(TargetOS)' == 'Windows_NT' and !Exists('$(NuGetPackageRoot)cdb-sos/$(cdbsosversion)/runtimes/$(TargetRid)/native/dbgeng.dll')"
           Text="DbgEng was not found in the cdb-sos package for '$(TargetRid)'." />
    <Error Condition="'$(TargetOS)' == 'linux' and !Exists('$(ArtifactsBinNativeDir)libsosplugin.so')"
           Text="The SOS lldb plugin was not found at '$(ArtifactsBinNativeDir)libsosplugin.so'." />
    <Error Condition="'$(TargetOS)' == 'osx' and !Exists('$(ArtifactsBinNativeDir)libsosplugin.dylib')"
           Text="The SOS lldb plugin was not found at '$(ArtifactsBinNativeDir)libsosplugin.dylib'." />
    <Error Condition="'$(TargetOS)' == 'osx' and !Exists('$(ArtifactsBinNativeDir)sos-lldb')"
           Text="The SOS lldb driver was not found at '$(ArtifactsBinNativeDir)sos-lldb'." />

    <RemoveDir Directories="$(SOSHelixPayloadDir)" />
    <MakeDir Directories="$(SOSHelixPayloadDir)" />
    <WriteLinesToFile File="$(SOSHelixPayloadDir)/.sos-test-payload"
                      Lines="$(TargetRid);$(Configuration)"
                      Overwrite="true"
                      Encoding="ASCII" />
    <Copy SourceFiles="@(_SOSPayloadFile)"
          DestinationFiles="@(_SOSPayloadFile->'$(SOSHelixPayloadDir)/%(DestinationRelative)')"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(SOSHelixPayloadDir)/.sos-test-payload')"
           Text="The SOS Helix payload marker was not staged." />
    <Error Condition="!Exists('$(SOSHelixPayloadDir)/artifacts/bin/SOS.Tests/$(Configuration)/$(NetCoreAppTestTargetFramework)/SOS.Tests.dll')"
           Text="SOS.Tests was not staged in the Helix payload." />
    <Error Condition="'$(TargetOS)' == 'Windows_NT' and !Exists('$(SOSHelixPayloadDir)/debugger/cdb.exe')"
           Text="CDB was not staged in the SOS Helix payload." />
    <Error Condition="'$(TargetOS)' == 'Windows_NT' and !Exists('$(SOSHelixPayloadDir)/debugger/dbgeng.dll')"
           Text="DbgEng was not staged in the SOS Helix payload." />
    <Error Condition="'$(TargetOS)' == 'osx' and !Exists('$(SOSHelixPayloadDir)/debugger/sos-lldb')"
           Text="The SOS LLDB driver was not staged in the SOS Helix payload." />
  </Target>

  <Target Name="SendToHelix" DependsOnTargets="StageSOSHelixPayload">
    <PropertyGroup>
      <_SOSTestRuntimeVersions>@(RuntimeTestVersions->'%(RuntimeDownload)', '|')</_SOSTestRuntimeVersions>
    </PropertyGroup>
    <MSBuild Projects="$(RepoRoot)eng/helix/SendToHelix.proj"
             Targets="Restore;Test"
             Properties="Configuration=$(Configuration);
                         TestDir=$(SOSHelixPayloadDir);
                         HelixWorkItemName=$(SOSHelixWorkItemName);
                         HelixWorkItemCommand=$(_SOSHelixWorkItemCommand);
                         HelixTargetQueues=$(HelixTargetQueues);
                         TargetOS=$(TargetOS);
                         TargetArch=$(TargetArch);
                         TargetRid=$(TargetRid);
                         DotNetRuntimeVersions=$(_SOSTestRuntimeVersions);
                         WorkItemTimeout=$(WorkItemTimeout);
                         OfficialBuildId=$(OfficialBuildId)" />
  </Target>

</Project>
