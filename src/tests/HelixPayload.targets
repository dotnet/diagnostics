<Project>
  <!-- Common routing: used by all test projects, including suites with custom submission targets.
       TestExecutionMode and HelixSubmissionTarget default in Directory.Build.props and can be
       set in each project. SkipTests must be evaluated here, after those project settings. -->
  <PropertyGroup>
    <SkipTests Condition="'$(SkipHelixTests)' == 'true' and ('$(TestExecutionMode)' == 'SingleHelixLeg' or '$(TestExecutionMode)' == 'Helix')">true</SkipTests>
  </PropertyGroup>

  <Target Name="ValidateTestExecutionMode" BeforeTargets="Build;RunTests">
    <Error Condition="'$(TestExecutionMode)' != 'AzDO' and '$(TestExecutionMode)' != 'SingleHelixLeg' and '$(TestExecutionMode)' != 'Helix'"
           Text="Invalid TestExecutionMode '$(TestExecutionMode)' in $(MSBuildProjectName). Expected AzDO, SingleHelixLeg, or Helix." />
  </Target>

  <Target Name="GetHelixTestProject" DependsOnTargets="ValidateTestExecutionMode" Returns="@(_HelixTestProject)">
    <ItemGroup Condition="'$(IsTestProject)' == 'true' and '$(TestExecutionMode)' != 'AzDO'">
      <_HelixTestProject Include="$(MSBuildProjectFullPath)">
        <AssemblyName>$(AssemblyName)</AssemblyName>
        <TestExecutionMode>$(TestExecutionMode)</TestExecutionMode>
        <HelixSubmissionTarget>$(HelixSubmissionTarget)</HelixSubmissionTarget>
      </_HelixTestProject>
    </ItemGroup>
  </Target>

  <Import Project="DefaultSendToHelix.targets" />
</Project>
