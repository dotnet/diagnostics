<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props"/>

  <PropertyGroup>
    <TestExecutionMode Condition="'$(TestExecutionMode)' == ''">AzDO</TestExecutionMode>
    <HelixSubmissionTarget Condition="'$(HelixSubmissionTarget)' == ''">DefaultSendToHelix</HelixSubmissionTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(EnableXUnitV3)' != 'false'">
    <TestRunnerName>XUnitV3</TestRunnerName>
    <OutputType>Exe</OutputType>
    <TestDotNetRoot Condition="'$(TestDotNetRoot)' == ''">$(ArtifactsDotnetTestDir)</TestDotNetRoot>
    <DefaultAppHostRuntimeIdentifier Condition="'$(TargetRid)' != ''">$(TargetRid)</DefaultAppHostRuntimeIdentifier>
  </PropertyGroup>
</Project>
