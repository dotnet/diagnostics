<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props"/>

  <!--
    xUnit v3 + Microsoft.Testing.Platform (MTP) opt-in for all test projects.

    Arcade's tools/Tests.props (imported via the root Directory.Build.props ->
    Arcade Sdk.props) sets IsTestProject=true for projects whose name ends in
    '.UnitTests' or '.Tests'. Setting TestRunnerName=XUnitV3 makes Arcade inject
    xunit.v3 and the MTP packages and default UseMicrosoftTestingPlatformRunner=true.
    xUnit v3 test projects must be built as executables.

    To temporarily keep a project off xUnit v3 (e.g. while it is being migrated),
    exclude it from the build in dirs.proj. A global escape hatch is available by
    setting EnableXUnitV3=false (e.g. on the command line).
  -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(EnableXUnitV3)' != 'false'">
    <TestRunnerName>XUnitV3</TestRunnerName>
    <OutputType>Exe</OutputType>

    <!--
      Point the test host at the test .NET install (artifacts/dotnet-test) instead of the
      Arcade toolset SDK (.dotnet). Arcade's XUnitV3 RunTests target launches each MTP test
      executable with DOTNET_ROOT=$(TestDotNetRoot) (and DOTNET_ROOT_X86=$(TestDotNetRoot)x86),
      defaulting TestDotNetRoot to $(DotNetRoot) == the repo .dotnet directory. That directory
      only carries a matching runtime because global.json installs one there via
      tools.runtimes (notably the x86 runtime used to host the Windows x86 test leg).

      artifacts/dotnet-test already receives the SDK and shared frameworks at the target
      architecture (see eng/InstallRuntimes.proj), so resolving the test host from there lets
      us drop the global.json tools.runtimes entry. Honor an explicit override if one is set.
    -->
    <TestDotNetRoot Condition="'$(TestDotNetRoot)' == ''">$(ArtifactsDotnetTestDir)</TestDotNetRoot>
  </PropertyGroup>
</Project>
